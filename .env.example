# ==============================================================================
# ESP8266 Evil Twin - Build & Configuration Environment Variables
#
# Duplicate this file as '.env' and adjust the configuration variables
# for your custom builds. Note: ESP8266 firmware values are typically set via
# C++ macro definitions or 'config.h' parameters at compile time.
# ==============================================================================

# Hardware Configurations
BOARD_TYPE=nodemcuv2
FLASH_BAUD=115200
CPU_SPEED_MHZ=160

# Admin Access Credentials
DEFAULT_ADMIN_SSID=EVIL_TWINS_BY_CHETAN
DEFAULT_ADMIN_PASSWORD=chetanngavali
PORTAL_IP_ADDRESS=192.168.4.1

# System Features
ENABLE_OLED_DISPLAY=true
ENABLE_EEPROM_PERSISTENCE=true
MAX_SAVED_LOGS=20
